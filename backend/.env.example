# Database Connection (Default: local SQLite file)
DATABASE_URL=sqlite:///./synapse.db
# For Supabase / PostgreSQL:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Server Cryptography & Hash-Chain Signing Secret
HMAC_SECRET=synapse-hmac-server-secret-key-2026-audit-integrity

# Gemini API Key (for structured extraction assistance)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (optional narrative explanations)
GROQ_API_KEY=your_groq_api_key_here

# Optional Tesseract OCR binary path (for Windows if not on system PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
